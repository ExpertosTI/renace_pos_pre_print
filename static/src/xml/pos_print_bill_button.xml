<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="renace_pos_pre_print.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']" position="after">
            <button t-att-class="buttonClass"
                t-att-disabled="!pos.get_order()?.get_orderlines()?.length"
                t-on-click="clickPrintBill">
                <i class="fa fa-print me-1"></i>Cuenta
            </button>
        </xpath>
    </t>
</templates>