<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_pre_print_form" model="ir.ui.view">
        <field name="name">Configuración de Pre Impresión</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="restaurant_section" position="inside">
                <h6>Módulo de Pre Impresión POS</h6>
                <setting string="Impresión Temprana de Recibos" help="Permite imprimir recibos antes del pago" id="iface_printbill2">
                    <field name="pos_iface_printbill"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>